    // it contains one more solution and it is 2 heaps and lazy deletion:
    // BY chatGPT:
    // TC = O(nlogk) and SC = O(n).

    priority_queue<int> small;  // max heap

    priority_queue<int,
                   vector<int>,
                   greater<int>> large;  // min heap

    unordered_map<int, int> delayed;

    int smallSize = 0;
    int largeSize = 0;

    void pruneSmall() {
        while(!small.empty() && delayed[small.top()] > 0) {
            delayed[small.top()]--;
            small.pop();
        }
    }

    void pruneLarge() {
        while(!large.empty() && delayed[large.top()] > 0) {
            delayed[large.top()]--;
            large.pop();
        }
    }

    void balance() {

        // small can have at most 1 extra
        if(smallSize > largeSize + 1) {

            large.push(small.top());
            small.pop();

            smallSize--;
            largeSize++;

            pruneSmall();
        }

        // large should never be bigger
        else if(smallSize < largeSize) {

            small.push(large.top());
            large.pop();

            largeSize--;
            smallSize++;

            pruneLarge();
        }
    }

    void add(int num) {

        if(small.empty() || num <= small.top()) {
            small.push(num);
            smallSize++;
        }
        else {
            large.push(num);
            largeSize++;
        }

        balance();
    }

    void remove(int num) {

        // Mark it for future deletion
        delayed[num]++;

        if(num <= small.top()) {

            smallSize--;

            if(num == small.top())
                pruneSmall();
        }
        else {

            largeSize--;

            if(!large.empty() && num == large.top())
                pruneLarge();
        }

        balance();
    }

    double getMedian(int k) {

        if(k % 2 == 1)
            return small.top();

        return ((long long)small.top() + large.top()) / 2.0;
    }

    vector<double> medianSlidingWindow(vector<int>& nums, int k) {

        vector<double> ans;

        for(int i = 0; i < k; i++) {
            add(nums[i]);
        }

        ans.push_back(getMedian(k));

        for(int right = k; right < nums.size(); right++) {

            remove(nums[right - k]);
            add(nums[right]);

            ans.push_back(getMedian(k));
        }

        return ans;
    }
