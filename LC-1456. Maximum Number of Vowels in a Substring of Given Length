    // more neat format:

    bool isVowel(char ch){
        return ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u';
    }
    int maxVowels(string s, int k) {
        int count = 0;

        for(int i = 0; i<k; i++){
            if (isVowel(s[i])) {
                count++;
            }
        }

        int maxCount = count;

        for(int i = k; i<s.length(); i++){
            if (isVowel(s[i])) {
                count++;
            }
            if (isVowel(s[i-k])) {
                count--;
            }
            maxCount = max(maxCount, count);
        }

        return maxCount;
    }
