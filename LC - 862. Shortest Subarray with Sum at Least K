        // 3. Prefix Sum + Min Heap TC = O(nlong) and SC = O(n);

        priority_queue<
            pair<long long,int>,
            vector<pair<long long,int>>,
            greater<pair<long long,int>>
        > pq;

        long long prefix = 0;
        int ans = INT_MAX;

        // prefix sum 0 at prefix index 0
        pq.push({0, 0});

        for(int i = 0; i < nums.size(); i++) {

