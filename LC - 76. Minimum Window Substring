        // 2nd method by chatGPT : missing count : it also has TC = O(n+m) and SC = O(1).

        unordered_map<char,int> need;

        for(char ch : t){
            need[ch]++;
        }

        int missing = t.size();

        int left = 0;
        int bestStart = 0;
        int bestLength = INT_MAX;

        for(int right = 0; right < s.size(); right++){
            if(need[s[right]] > 0){
                missing--;
            }

            need[s[right]]--;

            while(missing == 0){
                if(right - left + 1 < bestLength) {
                    bestLength = right - left + 1;
                    bestStart = left;
                }

                need[s[left]]++;

                if(need[s[left]] > 0){
                    missing++;
                }
                
                left++;
            }
        }

        
        if(bestLength == INT_MAX){
            return "";
        }
        return s.substr(bestStart,bestLength);
    }
