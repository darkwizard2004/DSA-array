    // return maxAvg;

// optimised answer by chatgpt:

    int windowSum = 0;

    for(int i = 0; i<k; i++){
        windowSum += nums[i];
    }

    int maxSum = windowSum;

    for(int i = k; i<nums.size(); i++){
        windowSum += nums[i];
        windowSum -= nums[i-k];
        maxSum = max(maxSum, windowSum);
    }

    return static_cast<double>(maxSum)/k;

    }
};
