problem - 
Given an integer array nums and an integer k, return the number of non-empty subarrays that have a sum divisible by k.

A subarray is a contiguous part of an array.

Example 1:
Input: nums = [4,5,0,-2,-3,1], k = 5
Output: 7
Explanation: There are 7 subarrays with a sum divisible by k = 5:
[4, 5, 0, -2, -3, 1], [5], [5, 0], [5, 0, -2, -3], [0], [0, -2, -3], [-2, -3]

Example 2:
Input: nums = [5], k = 9
Output: 0

Constraints:
1 <= nums.length <= 3 * 104
-104 <= nums[i] <= 104
2 <= k <= 104

solution -
class Solution {
public:
    int subarraysDivByK(vector<int>& nums, int k) {

        // optimised solution:TC = O(n) and SC = O(min(n,k));
        // using hashmap and count and sum variables intution -prefixSum;

        // unordered_map<int,int> mp;
        // mp[0] = 1;
        
        // we can also use freq vector as k is + in this problem.
        vector<int> freq(k, 0);
        freq[0] = 1;

        int count = 0;
        int sum = 0;

        for(int num:nums){
            sum+=num;
            
            // count += mp[sum%k];
            int rem = ((sum % k) + k) % k;

            // count += mp[((sum % k) + k) % k];
            // count += mp[rem];
            count += freq[rem];

            // mp[sum%k]++;
            // mp[((sum % k) + k) % k]++;
            // mp[rem]++;
            freq[rem]++;
        }
        return count;

